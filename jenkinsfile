
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('Build') {
            steps {
                sh 'npm run build'
            }
        }

        stage('Deploy') {
            steps {
                echo 'DEPLOY STARTED'

                withCredentials([
                    string(credentialsId: 'vercel-deploy-hook',
                           variable: 'VERCEL_HOOK')
                ]) {
                    sh '''
                        set +x
                        curl --fail --silent --show-error \
                          --request POST \
                          "$VERCEL_HOOK" > /dev/null
                    '''
                }

                echo 'Vercel deployment triggered'
            }
        }
    }

    post {
        success {
            echo 'BUILD SUCCESS'
            sendTelegram('SUCCESS')
        }

        failure {
            echo 'BUILD FAILED'
            sendTelegram('FAILED')
        }
    }
}

def sendTelegram(String status) {
    withCredentials([
        string(credentialsId: 'telegram-bot-token',
               variable: 'BOT_TOKEN'),
        string(credentialsId: 'telegram-chat-id',
               variable: 'CHAT_ID')
    ]) {
        withEnv(["BUILD_STATUS=${status}"]) {
            sh '''
                set +x
                curl --fail --silent --show-error \
                  --request POST \
                  "https://api.telegram.org/bot${BOT_TOKEN}/sendMessage" \
                  --data-urlencode "chat_id=${CHAT_ID}" \
                  --data-urlencode "text=Jenkins CI/CD: ${BUILD_STATUS}
Project: devops-test-giangg
Build: ${BUILD_NUMBER}
Vercel: https://devops-test-giangg.vercel.app/"
            '''
        }
    }
}
