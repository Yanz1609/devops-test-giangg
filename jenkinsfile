
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('Build') {
            steps {
                sh 'npm run build'
            }
        }

        stage('Deploy') {
            steps {
                echo 'DEPLOY STARTED'

                withCredentials([
                    string(
                        credentialsId: 'vercel-deploy-hook',
                        variable: 'VERCEL_HOOK'
                    )
                ]) {
                    sh '''
                        set +x
                        curl --fail --silent --show-error \
                          --request POST \
                          "$VERCEL_HOOK" > /dev/null
                    '''
                }

                echo 'Vercel deployment triggered'
            }
        }
    }

    post {
        success {
            echo 'BUILD SUCCESS'
            echo 'Vercel: https://devops-test-giangg.vercel.app/'
        }

        failure {
            echo 'BUILD FAILED'
            echo 'Please check Jenkins Console Output'
        }
    }
}
