
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('Build') {
            steps {
                sh 'npm run build'
            }
        }

        stage('Deploy') {
            steps {
                echo 'DEPLOY STARTED'

                withCredentials([
                    string(credentialsId: 'telegram-bot-token', variable: 'BOT_TOKEN'),
                    string(credentialsId: 'telegram-chat-id', variable: 'CHAT_ID')
                ]) {
                    sh '''
                        set +x
                        curl --fail --silent --show-error \
                          --data-urlencode "chat_id=$CHAT_ID" \
                          --data-urlencode "text=DEPLOY STARTED - Jenkins DevOps" \
                          "https://api.telegram.org/bot$BOT_TOKEN/sendMessage" > /dev/null
                    '''
                }

                withCredentials([
                    string(credentialsId: 'vercel-deploy-hook', variable: 'VERCEL_HOOK')
                ]) {
                    sh '''
                        set +x
                        curl --fail --silent --show-error \
                          --request POST \
                          "$VERCEL_HOOK" > /dev/null
                    '''
                }

                echo 'Vercel deployment triggered'
            }
        }
    }

    post {
        success {
            echo 'BUILD SUCCESS'

            withCredentials([
                string(credentialsId: 'telegram-bot-token', variable: 'BOT_TOKEN'),
                string(credentialsId: 'telegram-chat-id', variable: 'CHAT_ID')
            ]) {
                sh '''
                    set +x
                    curl --fail --silent --show-error \
                      --data-urlencode "chat_id=$CHAT_ID" \
                      --data-urlencode "text=BUILD SUCCESS - Jenkins CI/CD. Vercel deployment triggered." \
                      "https://api.telegram.org/bot$BOT_TOKEN/sendMessage" > /dev/null
                '''
            }
        }

        failure {
            echo 'BUILD FAILED'

            withCredentials([
                string(credentialsId: 'telegram-bot-token', variable: 'BOT_TOKEN'),
                string(credentialsId: 'telegram-chat-id', variable: 'CHAT_ID')
            ]) {
                sh '''
                    set +x
                    curl --fail --silent --show-error \
                      --data-urlencode "chat_id=$CHAT_ID" \
                      --data-urlencode "text=BUILD FAILED - Check Jenkins Console Output." \
                      "https://api.telegram.org/bot$BOT_TOKEN/sendMessage" > /dev/null
                '''
            }
        }
    }
}
